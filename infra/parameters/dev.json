{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": { "value": "westeurope" },
    "environment": { "value": "dev" },
    "imageTag": { "value": "local-validation" },
    "imageRepository": { "value": "atea-unified-workplace" },
    "containerRegistryName": { "value": "ateauwdevacr" },
    "containerAppEnvironmentName": { "value": "atea-uw-dev-env" },
    "containerAppName": { "value": "atea-uw-dev-app" },
    "workloadIdentityName": { "value": "atea-uw-dev-workload" },
    "keyVaultName": { "value": "atea-uw-dev-kv" },
    "logAnalyticsWorkspaceName": { "value": "atea-uw-dev-logs" },
    "applicationInsightsName": { "value": "atea-uw-dev-insights" },
    "postgresServerName": { "value": "atea-uw-dev-postgres" },
    "postgresDatabaseName": { "value": "workplace" },
    "postgresAdminLogin": { "value": "workplaceadmin" },
    "postgresSkuName": { "value": "Standard_B1ms" },
    "postgresStorageSizeGb": { "value": 32 },
