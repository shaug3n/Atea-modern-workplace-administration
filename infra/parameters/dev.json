    "entraProductionClientId": { "value": "00000000-0000-0000-0000-000000000002" },
    "entraProductionAudience": { "value": "api://atea-unified-workplace-prod" },
    "entraProductionRedirectUris": { "value": ["https://workplace.atea.com/auth/callback"] }
