# Copy to a local, ignored file before running a manual scenario.
# Never commit the copy. Leave ATEA_REAL_TENANT_RUN=false until the operator
# has confirmed the tenant, app registration and disposable test objects.
ATEA_REAL_TENANT_RUN=false
ATEA_REAL_TENANT_BASE_URL=https://localhost:5001
ATEA_REAL_TENANT_TENANT_ID=

# Short-lived API access token. Load it from a local secret store or shell only.
# Do not paste it into this file, a terminal transcript, CI, or test evidence.
ATEA_REAL_TENANT_ACCESS_TOKEN=

# Object IDs only. Keep the local values in a secret store or ignored env file.
ATEA_REAL_TENANT_WORKSPACE_ID=
ATEA_REAL_TENANT_CUSTOMER_ADMIN_OBJECT_ID=
ATEA_REAL_TENANT_GLOBAL_READER_OBJECT_ID=
ATEA_REAL_TENANT_USER_ADMINISTRATOR_OBJECT_ID=
ATEA_REAL_TENANT_PIM_ELIGIBLE_OBJECT_ID=
ATEA_REAL_TENANT_PIM_APPROVAL_OBJECT_ID=
ATEA_REAL_TENANT_ATEA_GUEST_OBJECT_ID=
ATEA_REAL_TENANT_TEST_USER_OBJECT_ID=
ATEA_REAL_TENANT_TEST_GROUP_OBJECT_ID=

# One-time invitation nonce. Treat it like a credential; keep it in memory only
# while redeeming and clear it immediately after use.
ATEA_REAL_TENANT_INVITATION_NONCE=
